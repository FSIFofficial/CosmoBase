+      </text>
+      <text x="436" y={py + 76} fontSize="17" fill="currentColor" fillOpacity="0.75">
+        火星から約9,400 km
+      </text>
+      <text x="436" y={py + 98} fontSize="17" fill="currentColor" fillOpacity="0.75">
